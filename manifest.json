{
  "manifest_version": 3,
  "name": "InSIS+",
  "version": "0.8.0",
  "description": "Faster, friendlier InSIS (insis.vse.cz): a task-based menu, Ctrl+K search, a dashboard and redesigned study pages. Everything stays in your browser.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://insis.vse.cz/*"
      ],
      "js": [
        "content.js",
        "nav-data.js",
        "nav.js",
        "ui.js",
        "kit.js",
        "todo.js",
        "composed.js",
        "course.js",
        "home.js",
        "syllabus.js",
        "catalog.js",
        "pages/timetable.js",
        "pages/student-portal.js",
        "pages/submissions.js",
        "pages/study-record.js",
        "pages/docserver.js",
        "pages/messages.js",
        "pages/library.js",
        "pages/plan-progress.js",
        "pages/tests.js",
        "pages/weeks.js",
        "pages/study-plans.js",
        "pages/ematerials.js",
        "pages/surveys.js",
        "pages/financing.js",
        "pages/persons.js",
        "pages/noticeboard.js",
        "pages/requests.js",
        "generic.js",
        "sync.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "palette.css",
        "shared.css",
        "home.css",
        "syllabus.css",
        "catalog.css",
        "course.css",
        "kit.css",
        "generic.css",
        "pages/*"
      ],
      "matches": [
        "https://insis.vse.cz/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "insis-plus@students.vse",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}

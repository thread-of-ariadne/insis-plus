{
  "manifest_version": 3,
  "name": "InSIS+",
  "version": "0.9.0",
  "description": "Faster, friendlier InSIS (insis.vse.cz): a task-based menu, Ctrl+K search, a dashboard and redesigned study pages. Everything stays in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://insis.vse.cz/*"
      ],
      "js": [
        "boot.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://insis.vse.cz/*"
      ],
      "js": [
        "content.js",
        "nav-data.js",
        "nav.js",
        "ui.js",
        "kit.js",
        "pages/rebuild.js",
        "pages/lists.js",
        "todo.js",
        "composed.js",
        "course.js",
        "home.js",
        "syllabus.js",
        "catalog.js",
        "pages/timetable.js",
        "pages/student-portal.js",
        "pages/submissions.js",
        "pages/study-record.js",
        "pages/docserver.js",
        "pages/messages.js",
        "pages/library.js",
        "pages/plan-progress.js",
        "pages/tests.js",
        "pages/weeks.js",
        "pages/study-plans.js",
        "pages/ematerials.js",
        "pages/surveys.js",
        "pages/financing.js",
        "pages/persons.js",
        "pages/noticeboard.js",
        "pages/requests.js",
        "pages/exams.js",
        "pages/folder.js",
        "pages/papers.js",
        "pages/excuses.js",
        "pages/thesis.js",
        "pages/abroad.js",
        "pages/internships.js",
        "pages/elections.js",
        "pages/reg-stats.js",
        "pages/study-map.js",
        "pages/classmates.js",
        "pages/topics.js",
        "pages/submission-box.js",
        "pages/registration.js",
        "pages/eplans.js",
        "pages/public-courses.js",
        "pages/departments.js",
        "pages/person.js",
        "pages/rooms.js",
        "pages/account.js",
        "pages/help.js",
        "pages/services.js",
        "generic.js",
        "sync.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "palette.css",
        "shared.css",
        "home.css",
        "syllabus.css",
        "catalog.css",
        "course.css",
        "kit.css",
        "generic.css",
        "pages/*"
      ],
      "matches": [
        "https://insis.vse.cz/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "insis-plus@students.vse",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "112"
}
